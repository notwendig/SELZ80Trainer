; End of function sub_BBA


; =============== S U B	R O U T	I N E =======================================

; Move mem

ExtendE:				; CODE XREF: Extend4_8+51j

; FUNCTION CHUNK AT 070C SIZE 00000008 BYTES

		call	GetStartEndAddr	; HL = start
					; BC = size
		jp	c, RangeError
		push	bc
		ld	hl, dpl_Ad_d	; A
		call	ClrGetAddr
		ex	de, hl
		ld	hl, (TempWord)	; StartAddr
		push	hl
		or	a
		sbc	hl, de
		pop	hl
		pop	bc
		jr	nc, Downward
		add	hl, bc		; EndAddr
		dec	hl
		push	hl
		ex	de, hl
		add	hl, bc
		dec	hl
		ex	de, hl
		pop	hl
		lddr
		jr	retMove
; ---------------------------------------------------------------------------

Downward:				; CODE XREF: ExtendE+17j
		ldir

retMove:				; CODE XREF: ExtendE+23j
		call	WaitEnter
		jp	MainLoop
; End of function ExtendE


; =============== S U B	R O U T	I N E =======================================

; Fill Mem

ExtendF:				; CODE XREF: Extend4_8+56j
		call	GetStartEndAddr	; HL = start
					; BC = size
		jp	c, RangeError
		call	EnterDataByte
		ld	e, a

fillloop:				; CODE XREF: ExtendF+Fj
		ld	(hl), e
		inc	hl
		dec	bc
		ld	a, b
		or	c
		jr	nz, fillloop
		call	WaitEnter
		jp	MainLoop
; End of function ExtendF


; =============== S U B	R O U T	I N E =======================================

; HL = start
; BC = size

GetStartEndAddr:			; CODE XREF: ExtendEp ExtendFp ...
		ld	hl, dpl_Adrs	; A
		call	ClrGetAddr
		ld	(TempWord), hl
		ld	hl, dpl_Adre	; A
		call	ClrGetAddr
		push	hl
		ld	hl, (TempWord)
		ex	de, hl
		pop	hl
		inc	hl
		or	a
		sbc	hl, de
		ret	c
		jr	nz, Valid
		scf
		ret
; ---------------------------------------------------------------------------

Valid:					; CODE XREF: GetStartEndAddr+1Aj
		push	hl
		pop	bc
		ld	hl, (TempWord)
		ret
; End of function GetStartEndAddr


; =============== S U B	R O U T	I N E =======================================

; Print	Register

ExtendC:				; CODE XREF: Extend4_8+47j
		call	PIOMode1InA
		jr	z, PrinterNotReady ; PC	& 10 = 0
		ld	hl, RegsPrint
		ld	b, 2
		call	PrintReg_b
		ld	hl, PrmtTS
		call	PromptIHLI
		ld	b, 0Fh

Space16:				; CODE XREF: ExtendC+18j
		call	PrintSpace
		djnz	Space16
		ld	hl, PmtFlags
		ld	b, 8

PromtFlags:				; CODE XREF: ExtendC+24j
		ld	c, (hl)
		inc	hl
		call	PrintC
		djnz	PromtFlags
		call	PrinterCRLF
		ld	hl, PrmtAF
		ld	b, 4
		call	PrintReg_b
		ld	hl, PrmtFG
		call	PromtBinByte
		call	PrinterCRLF
		ld	hl, PrmtAF_
		ld	b, 4
		call	PrintReg_b
		ld	hl, PrmtFG_
		call	PromtBinByte
		call	PrinterCRLF
		ld	hl, PrmtIX
		ld	b, 3
		call	PrintReg_b
		call	PrinterCRLF

LFRet:					; CODE XREF: ExtendD+6Ej
		call	Pio2CRLF

RetPReg:				; CODE XREF: ExtendC+5Fj
		jp	MainLoop
; ---------------------------------------------------------------------------

PrinterNotReady:			; CODE XREF: ExtendC+3j ExtendD+21j
		call	FlashDisplay
		jr	RetPReg
; End of function ExtendC

; ---------------------------------------------------------------------------
RegsPrint:	db 'P', 'C', ' '        ; DATA XREF: ExtendC+5o
		dw UserProgramPtr
		db 'S', 'P', ' '
		dw UsetStackPtr
PrmtTS:		db 'T', 'S', ' '        ; DATA XREF: ExtendC+Do
		dw UsetStackPtr
PrmtAF:		db 'A', 'F', ' '        ; DATA XREF: ExtendC+29o
		dw UserRegAF
		db 'B', 'C', ' '
		dw UserRegBC
		db 'D', 'E', ' '
		dw UserRegDE
		db 'H', 'L', ' '
		dw UserRegHL
PrmtFG:		db 'F', 'G', ' '        ; DATA XREF: ExtendC+31o
		dw UserRegAF
PrmtAF_:	db 'A', 'F', '`'        ; DATA XREF: ExtendC+3Ao
		dw UserRegAF_
		db 'B', 'C', '`'
		dw UserRegBC_
		db 'D', 'E', '`'
		dw UserRegDE_
		db 'H', 'L', '`'
		dw UserRegHL_
PrmtFG_:	db 'F', 'G', '`'        ; DATA XREF: ExtendC+42o
		dw UserRegAF_
PrmtIX:		db 'I', 'X', ' '        ; DATA XREF: ExtendC+4Bo
		dw UserRegIX
		db 'I', 'Y', ' '
		dw UserRegIY
		db 'I', '/', 'R'
		dw RegIR
PmtFlags:	db 'S', 'Z', 'x', 'H', 'x', 'V', 'N', 'C' ; DATA XREF: ExtendC+1Ao

; =============== S U B	R O U T	I N E =======================================

; PrintMemdump

ExtendD:				; CODE XREF: Extend4_8+4Cj
		call	GetStartEndAddr	; HL = start
					; BC = size
		jp	c, RangeError
		ld	a, c
		and	0F0h
		add	a, 10h
		ld	e, a
		ld	a, 0
		adc	a, b
		ld	d, a		; DE = Size alligned xxx0
		ld	b, 4

div16:					; CODE XREF: ExtendD+16j
		srl	d
		rr	e
		djnz	div16
		ld	c, e
		ld	b, d		; BC = sise / 16
		ld	a, l
		and	0F0h
		ld	l, a		; HL = Start alligned 16
		call	PIOMode1InA
		jr	z, PrinterNotReady
		push	hl
		push	bc
		ld	hl, DumpHeader	; " Addr. x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 xA"...
		ld	b, 72

PrintHeader:				; CODE XREF: ExtendD+2Fj
		ld	c, (hl)
		call	PrintC
		inc	hl
		djnz	PrintHeader
		call	Pio2CRLF
		pop	bc
		pop	hl

PrintAddr:				; CODE XREF: ExtendD+6Cj
		push	bc
		call	PioHLSpaceOut
		ld	b, 10h
		push	hl

PrintHex16:				; CODE XREF: ExtendD+45j
		ld	a, (hl)
		call	PrintHex
		call	PrintSpace
		inc	hl
		djnz	PrintHex16
		call	PrintSpace
		pop	hl
		ld	b, 10h

PrintAscii:				; CODE XREF: ExtendD+63j
		ld	c, (hl)
		ld	a, c
		and	80h
		jr	z, Printable

notPrintable:				; CODE XREF: ExtendD+5Cj
		ld	c, '.'
		jr	PrintAsciiChar
; ---------------------------------------------------------------------------

Printable:				; CODE XREF: ExtendD+51j
		ld	a, c
		and	7Fh
		cp	' '
		jr	c, notPrintable
		ld	c, a

PrintAsciiChar:				; CODE XREF: ExtendD+55j
		call	PrintC
		inc	hl
		djnz	PrintAscii
		call	PrinterCRLF
		pop	bc
		dec	bc
		ld	a, b
		or	c
		jr	nz, PrintAddr
		jp	LFRet
; End of function ExtendD

; ---------------------------------------------------------------------------
DumpHeader:	.ascii ' Addr. x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 xA xB xC xD xE xF'
					; DATA XREF: ExtendD+25o
		.ascii '  0123456789ABCDEF'

; =============== S U B	R O U T	I N E =======================================


PIOMode1InA:				; CODE XREF: PRTINIj ExtendCp	...
		ld	a, 8Ch		; Mode 1 PC[7-4] input
		out	(PIO_8255_CntrlStatus),	a
		ld	a, 9		; Bit 4	set
		out	(PIO_8255_CntrlStatus),	a
		in	a, (PIO_8255_PortC)
		and	10h
		ld	a, 70h
		ret
; End of function PIOMode1InA


; =============== S U B	R O U T	I N E =======================================


PioPromptHL3:				; CODE XREF: PioRegOutp
					; PioRegOut:PromptIHLIp ...
		push	bc
		ld	b, 3

loc_DC9:				; CODE XREF: PioPromptHL3+8j
		ld	c, (hl)
		inc	hl
		call	PrintC
		djnz	loc_DC9
		pop	bc
		ld	c, '='
		call	PrintC
		call	HL_IHLI		; HL = (HL)
		jp	HL_IHLI		; HL = (HL)
; End of function PioPromptHL3


; =============== S U B	R O U T	I N E =======================================


PrintReg_b:				; CODE XREF: ExtendC+Ap ExtendC+2Ep ...
		push	hl
		call	PioRegOut
		pop	hl
		ld	de, 5
