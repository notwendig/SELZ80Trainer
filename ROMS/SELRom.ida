		db 0FFh

; =============== S U B	R O U T	I N E =======================================


NMI:
		ld	(TempByte), a
		ld	a, 0FFh
		out	(LS73_90_P8), a	; Stop NMI trigger
		ld	a, (TempByte)
		ld	(TempWord), hl
		pop	hl

SafeUserBreak:				; DATA XREF: Breakpoint+1Ao
		ld	(UserProgramPtr), hl
		ld	(UsetStackPtr),	sp
		ld	sp, UserRegSP
		ld	hl, (TempWord)
		push	iy
		push	ix
		exx
		push	hl
		push	de
		push	bc
		exx
		ex	af, af'
		push	af
		ex	af, af'
		push	hl
		push	de
		push	bc
		push	af
		ld	a, i
		ld	(RegIR), a
		ld	a, 0
		jp	po, rr
		ld	a, 1

rr:					; CODE XREF: NMI+32j
		ld	(RegIR+1), a
		ld	sp, SysStackTop
		ld	hl, dpl_bp_	; -
		call	SENDPR_1	; HL-Anzeige (links)
					; Durch	Aufruf des Unterprogramms SENDPR 1 wird, wie SENDPTR aber
					; ohne Laden des C-Registers, zu den 4 linken Anzeigen ausgegeben.
		ld	hl, (UserProgramPtr)
		call	DisplayHLData	; Display byte HL on the right Segemnts
		jp	WaitDoFunction
; End of function NMI


; =============== S U B	R O U T	I N E =======================================


Breakpoint:				; CODE XREF: BREAKj
		ex	(sp), hl
		dec	hl
		ex	(sp), hl
		ld	(TempWord), hl
		push	af
		call	RestorBreakPoint ; Remove Breake-Point
		ld	a, (BreakCounter)
		or	a
		jr	z, DoBreakPoint
		xor	a
		out	(LS73_90_P8), a	; Start	NMI trigger on 5 M1
		pop	af		; M1
		nop			; M2
		ld	hl, (TempWord)	; M3
		ret			; M4
; ---------------------------------------------------------------------------

DoBreakPoint:				; CODE XREF: Breakpoint+Ej
		pop	af
		ld	hl, SafeUserBreak
		ex	(sp), hl
		ret
; End of function Breakpoint


; =============== S U B	R O U T	I N E =======================================


Func_BP:				; DATA XREF: ROM:0338o
		call	RestorBreakPoint ; Remove Breake-Point
		ld	hl, dpl_bp	; b
		call	GetAddr
		push	hl
		call	WaitEnter
		pop	hl
		ld	(BreakPointAddr), hl
		ld	de, BreakPointOrig
		ld	a, (hl)
		ld	(de), a
		inc	de
		ld	a, 0D7h		; rst 10
		ld	(de), a
		ld	(hl), a
		jp	MainLoop
; End of function Func_BP


; =============== S U B	R O U T	I N E =======================================


InitSys:				; CODE XREF: start+19p
		xor	a
		out	(BinIO_PC), a	; Clear	LED
		ld	(LEDStatus), a	; All OFF
		cpl
		out	(UserDisplay_1), a ; Clear User	Display
		im	1
		ld	a, 0FBh		; EI
		ld	(UserIntProc), a
		ld	hl, 0C9h	; RET, NOP
		ld	(UserIntProc+1), hl
		ld	hl, Init8279
		ld	bc, 300	| IC8279_Ctrl ;	3 byte from (HL) to port 1 8279	Key Dsply Driver
		otir

wack:					; CODE XREF: InitSys+22j
		in	a, (IC8279_Ctrl)
		and	80h		; Ready
		jr	nz, wack
		ld	bc, 4
		push	hl
		ld	de, SIO8251Config
		ldir
		pop	hl
		ld	bc, 419h	; 4byte	to SIO8251_CntrPort
		otir
		dec	hl
		ld	a, (hl)
		ld	(SIOMode), a
		ei
; End of function InitSys


; =============== S U B	R O U T	I N E =======================================

; Remove Breake-Point

RestorBreakPoint:			; CODE XREF: Breakpoint+7p Func_BPp ...
		ld	a, (BreakPointCode) ; Restores the original op-code overwritten	by breakpoint RST 10 code
		cp	0D7h		; RST 10
		jr	nz, NotSet
		ld	hl, (BreakPointAddr)
		ld	a, (BreakPointOrig)
		ld	(hl), a

NotSet:					; CODE XREF: RestorBreakPoint+5j
		xor	a
		ld	(BreakPointCode), a
		ret
; End of function RestorBreakPoint

; ---------------------------------------------------------------------------
Init8279:	db 10h,	39h, 0C1h	; DATA XREF: InitSys+16o
					; 10: 8bit char	- encode 2key lock-out
					; 39: Clock 19
					; C1: Clear Display
Init8251:	db 91h,	40h, 0CEh, 17h	; 91: Stop=1.5,	PAR=ODD, 5Bits,	1x
					; 40: Error reset
					; CE: ???
					; 17:Error reset, RxEN,TxEN,DTR
					; or
					; 25:RTS, SBrk,TxEN

; =============== S U B	R O U T	I N E =======================================


start:					; CODE XREF: KALTSTARTj
		xor	a
		ld	(BreakCounter),	a
		ld	hl, UserRamStart
		ld	(UserProgramPtr), hl
		ld	(AddrBuffer), hl
		ld	hl, IOBitTimer	; System Data
		ld	(UsetStackPtr),	hl
		ld	sp, SysStackTop
		call	RestorBreakPoint ; Remove Breake-Point
		call	InitSys
; End of function start


; =============== S U B	R O U T	I N E =======================================


MainLoop:				; CODE XREF: WARMSTARTj Func_BP+1Bj ...
		ld	hl, intro
		call	SENDDS_1	; 8-Digit-Anzeige (kom)

WaitDoFunction:				; CODE XREF: NMI+49j
		ld	hl, FuncDispatcher
		call	WaitEnterFunction ; Wait function key return func-address on HL
		jp	(hl)		; Do Funktion
; ---------------------------------------------------------------------------
		xor	a
		ld	(BreakCounter),	a
		jr	MainLoop
; End of function MainLoop


; =============== S U B	R O U T	I N E =======================================

; Lies Zeichen von Tastatur

_INCH:					; CODE XREF: INCHj _INCH+4j ...
		in	a, (IC8279_Ctrl)
		and	FIFOMSK		; Mask Key buffer counter
		jr	z, _INCH	; Kein Zeichen,	warte bis Zeichen vorhanden.
; End of function _INCH


; =============== S U B	R O U T	I N E =======================================


GetKey:					; CODE XREF: EditFlags+7p
		in	a, (IC8279_Data)
		and	KBMASK		; Maske	auf Maximalcode
		push	af		; Matrix Code sichern
		ld	a, CLFIFO	; Clear	Key and	Int reset
		out	(IC8279_Ctrl), a
		pop	af
		ret
; End of function GetKey


; =============== S U B	R O U T	I N E =======================================

; shift	display-data left and insert a

InsertData:				; CODE XREF: GetAddr:loc_216p
					; Func_RG+BAp
		ld	hl,  OUTBU+2
		ld	de,  OUTBU+3
		ld	bc, 3
		lddr
		ld	(de), a
; End of function InsertData


; =============== S U B	R O U T	I N E =======================================

; Refresh Display Buffer to Device

_OUTCH:					; CODE XREF: OUTCHj GetAddr+1Fp ...
		push	hl
		push	bc
		ld	hl,  OUTBU+7	; Zeiger auf Bufferende
		ld	bc, 8*100h+WRDIS ; Anzahl der Stellen nach Register B, Schreibkommando mit Stellenadresse nach Register	C

OUTLP:					; CODE XREF: _OUTCH+10j
		ld	a, c		; Schreibkommando und Stellenadresse
		out	(IC8279_Ctrl), a
		ld	a, (hl)		; Daten	aus Buffer
		out	(IC8279_Data), a
		inc	c		; Erhöhe Stellenadresse
		dec	hl		; Erniedrige Buffer-Zeiger
		djnz	OUTLP		; Schreibkommando und Stellenadresse
		pop	bc
		pop	hl
		ret
; End of function _OUTCH


; =============== S U B	R O U T	I N E =======================================


WaitEnter:				; CODE XREF: Func_BP+Ap WaitEnter+5j ...
		call	GetCtrlKey	; Wait for Key.	Return A=FF if not an Control-Key
		cp	1Eh		; Key EN
		jr	nz, WaitEnter
		ret
; End of function WaitEnter


; =============== S U B	R O U T	I N E =======================================

; Wait for Key.	Return A=FF if not an Control-Key

GetCtrlKey:				; CODE XREF: WaitEnterp
					; WaitEnterFunction:waitcontrolkeyp ...

; FUNCTION CHUNK AT 01B5 SIZE 00000003 BYTES

		push	hl
		ld	hl, keyctrlmap	; Key MM
		jr	DoGetKey
; End of function GetCtrlKey


; =============== S U B	R O U T	I N E =======================================

; Wait for Key.	Return A=FF if not an Hex-Key

_GETH:					; CODE XREF: GETHj GetAddr:waithexkeyp ...
		push	hl
		ld	hl, TABD	; HEX Code Tabelle
; End of function _GETH

; START	OF FUNCTION CHUNK FOR GetCtrlKey

DoGetKey:				; CODE XREF: GetCtrlKey+4j
		call	_INCH		; Lies Zeichen von Tastatur
; END OF FUNCTION CHUNK	FOR GetCtrlKey

; =============== S U B	R O U T	I N E =======================================


MapKey:					; CODE XREF: MapAonHexKeyMap+4j
		ld	b, a		; Matrix Code

GETLP:					; CODE XREF: MapKey+Bj
		ld	a, (hl)
		cp	0FFh		; end of map
		jr	z, GETEND
		cp	b
		jr	z, HOLE
		inc	hl
		inc	hl
		jr	GETLP
; ---------------------------------------------------------------------------

HOLE:					; CODE XREF: MapKey+7j
		inc	hl
		ld	a, (hl)

GETEND:					; CODE XREF: MapKey+4j
		pop	hl
		ret
; End of function MapKey


; =============== S U B	R O U T	I N E =======================================

; Returns FF if	rA is not a HexKeyCode

MapAonHexKeyMap:			; CODE XREF: Func_MM+4Dp
		push	hl
		ld	hl, TABD	; HEX Code Tabelle
		jr	MapKey
; End of function MapAonHexKeyMap


; =============== S U B	R O U T	I N E =======================================


ClrGetAddr:				; CODE XREF: Func_TW+3p Func_TW+Ap ...
		push	hl
		ld	hl, 0
		ld	(AddrBuffer), hl
		pop	hl
; End of function ClrGetAddr


; =============== S U B	R O U T	I N E =======================================


GetAddr:				; CODE XREF: Func_BP+6p Func_MM+8Fp ...

; FUNCTION CHUNK AT 01F0 SIZE 00000045 BYTES

		call	SENDPR_1	; HL-Anzeige (links)
					; Durch	Aufruf des Unterprogramms SENDPR 1 wird, wie SENDPTR aber
					; ohne Laden des C-Registers, zu den 4 linken Anzeigen ausgegeben.
		push	de
		push	bc
		jr	Clr4GetAddress	; 1 x D7
; End of function GetAddr


; =============== S U B	R O U T	I N E =======================================

; returns Address on HL

EditAddress:				; CODE XREF: Func_MM+6p Func_RN+10p
		push	de
		push	bc
		ld	hl, (AddrBuffer)
		call	DisplayHLData	; #### HHLL
		jr	EnterAddress
; End of function EditAddress


; =============== S U B	R O U T	I N E =======================================


ClrGetAddress:				; CODE XREF: GETADRj
		push	de
		push	bc
		ld	bc, 800h	; 8 x 0
		call	FillDispl	; set all Segments to 0
; End of function ClrGetAddress

; START	OF FUNCTION CHUNK FOR GetAddr

Clr4GetAddress:				; CODE XREF: GetAddr+5j
		ld	bc, 4F3h	; 4 x F3 = ####	0000
		call	FillDispl	; fill Display b bytes with c
		call	_OUTCH		; Refresh Display Buffer to Device

EnterAddress:				; CODE XREF: EditAddress+8j
		ld	hl, 0

waithexkey:				; CODE XREF: GetAddr+2Aj GetAddr+43j
		call	_GETH		; Wait for Key.	Return A=FF if not an Hex-Key
		cp	0FFh
		jr	z, waithexkey
		cp	KeyCode_SA	; accept address
		jr	z, acceptaddr
		ld	b, a
		add	hl, hl
		add	hl, hl
		add	hl, hl
		add	hl, hl
		add	a, l
		ld	l, a
		ld	(AddrBuffer), hl
		push	hl
		ld	a, b
		call	_CONV7SEG

loc_216:				; shift	display-data left and insert a
		call	InsertData
		pop	hl
		jr	waithexkey
; ---------------------------------------------------------------------------
; Copy data #### nnnn to address nnnn ####

acceptaddr:				; CODE XREF: GetAddr+2Ej
		ld	hl, OUTBU
		ld	de,  OUTBU+4
		ld	bc, 4
		ldir			; Move data-display to address-display
		ld	b, 4
		call	FillDispl	; clear	data display
		ld	hl, (AddrBuffer)
		call	_OUTCH		; Refresh Display Buffer to Device
		pop	bc
		pop	de
		ret
; END OF FUNCTION CHUNK	FOR GetAddr

; =============== S U B	R O U T	I N E =======================================

; fill Display b bytes with c

FillDispl:				; CODE XREF: ClrGetAddress+5p
					; GetAddr+1Cp ...
		ld	de, OUTBU
		ld	a, c

loFillDispl:				; CODE XREF: FillDispl+6j
		ld	(de), a
		inc	de
		djnz	loFillDispl
		ret
; End of function FillDispl


; =============== S U B	R O U T	I N E =======================================


_CONV7SEG:				; CODE XREF: CONV7SEGj	GetAddr+3Cp ...
		push	hl
		push	bc
		and	LSD		; Last signifikant digit
		ld	c, a		; Offset in Lookup-Tabelle
		ld	hl, TAB7	; Tabellenanfang
		ld	b, 0
		add	hl, bc		; Zeiger auf Zeichen in	Tabelle
		ld	a, (hl)		; Lade 7 Segment Code zum Zeichen
		pop	bc
		pop	hl
		ret
; End of function _CONV7SEG


; =============== S U B	R O U T	I N E =======================================


DisplayByteDataMsb:			; CODE XREF: Func_MM+Ep
					; EnterDataByte+46p
		ld	c, 1
; End of function DisplayByteDataMsb


; =============== S U B	R O U T	I N E =======================================

; Displays byte	a on 2 segments	at c

DispBytePos:				; CODE XREF: SENDAj DisplyHL+Bp ...
		push	hl
		push	bc
		ld	hl, OUTBU	; #### #### <-
		ld	b, a		; byte to display
		push	bc
		ld	b, 0
		ld	a, c		; Position
		cp	4		; #### #### <-7654 3210
		jr	nc, DisplByte	; absolut Segment 4-7
		add	hl, bc		; byte offse 76	54 32 10
		add	hl, bc		; 0->+0, 1->+2,	2->+4, 3->+6

DisplByte:				; CODE XREF: DispBytePos+Cj
		pop	bc
		ld	a, b		; Byte to display on segment
		call	_CONV7SEG	; Convert bin to 7-segment
		ld	(hl), a		; LSNipple
		inc	hl
		ld	a, b
		rrca
		rrca
		rrca
		rrca
		call	_CONV7SEG
		ld	(hl), a		; MSNipple
		call	_OUTCH		; Refresh Display Buffer to Device
		pop	bc
		pop	hl
		ret
; End of function DispBytePos


; =============== S U B	R O U T	I N E =======================================

; Display byte HL on the right Segemnts

DisplayHLData:				; CODE XREF: NMI+46p EditAddress+5p ...
		ld	c, 0
; End of function DisplayHLData


; =============== S U B	R O U T	I N E =======================================

; Display HL on
; c != 1 Data #### HHLL
; c == 0 Addr HHLL ####
;

DisplyHL:				; CODE XREF: SENDHLj
		ld	a, c		; pos
		or	a
		jr	z, UsePos	; Pos 0	#### HHLL
		inc	c
		dec	a
		jr	z, UsePos	; pos 1	HHLL ####
		ld	c, 0		; #### ##XX

UsePos:					; CODE XREF: DisplyHL+2j DisplyHL+6j
		ld	a, l
		call	DispBytePos	; Displays byte	a on 2 segments	at c
		inc	c		; #### XX##
		ld	a, h
		call	DispBytePos	; Displays byte	a on 2 segments	at c
		ret
; End of function DisplyHL

;Segment 0
;if a == 1 copy	next from (hl)e
;lse use a for Display 0

; =============== S U B	R O U T	I N E =======================================

; Copies 8 byte	from (HL) or A to Display 7..0
;

CopyHLAtoDisplay:			; CODE XREF: SENDDSj FlashDisplay+9p
		push	de
		push	bc
		ld	de,  OUTBU+7	; Start	at Segment on the left
		ld	bc, 7
		lddr
		cp	1
		jr	nz, UseA
		ld	a, (hl)		; if a == 1 then next 8. byte too

UseA:					; CODE XREF: CopyHLAtoDisplay+Cj
		ld	(de), a
		call	_OUTCH		; Refresh Display Buffer to Device
		pop	bc
		pop	de
		ret
; End of function CopyHLAtoDisplay


; =============== S U B	R O U T	I N E =======================================

; SetHLtoDisp Data

SetHLtoDispData:			; CODE XREF: Func_RN+1Cp Func_TR+Dp
		ld	c, 0
; End of function SetHLtoDispData

;Copy 4	bytes to system	display
;c == 1	left 4 Segments	(address)
;c != 1	right 4	Segments (data)

; =============== S U B	R O U T	I N E =======================================

; Copy 4 byte (HL..HL-3) to Display

Display4pHL:				; CODE XREF: SENDPRj
		push	de
		push	bc
		ld	de,  OUTBU+7	; -> #### ####
		dec	c		; 1 -> 0 then TopPosition
		jr	z, UseDisplSection
		ld	de,  OUTBU+3	; #### -> ####

UseDisplSection:			; CODE XREF: Display4pHL+6j
		ld	bc, 4		; 4 7Seg Displays
		lddr
		call	_OUTCH		; Refresh Display Buffer to Device
		pop	bc
		pop	de
		ret
; End of function Display4pHL


; =============== S U B	R O U T	I N E =======================================

; B * 5ms

DelayBx5ms:				; CODE XREF: DELAYj
		push	bc
; 2437 usec
; 265 *	9.5usec	+ 1.75usec + 3.25usec

loc_2BA:				; CODE XREF: DelayBx5ms+Aj
		ld	c, 0		; 2 7 1.75

Wait8_5:				; CODE XREF: DelayBx5ms+8j
		inc	bc		; 1 6 1.5
		dec	bc		; 1 6 1.5
		inc	bc		; 1 6 1.5
		dec	bc		; 1 6 1.5
		dec	c		; 1 4 1.0
		jr	nz, Wait8_5	; 3 10 2.5
		djnz	loc_2BA		; 3 13 3.25 * B
					; 2  8 2.0
		pop	bc		; 3 10 2.5
		ret			; 3 10 2.5
; End of function DelayBx5ms


; =============== S U B	R O U T	I N E =======================================

; Wait function	key return func-address	on HL

WaitEnterFunction:			; CODE XREF: MainLoop+9p
		push	de
		push	bc

WaitFunction:				; CODE XREF: WaitEnterFunction+2Dj
		push	hl
		pop	de

waitcontrolkey:				; CODE XREF: WaitEnterFunction+Aj
		call	GetCtrlKey	; Wait for Key.	Return A=FF if not an Control-Key
		ld	b, a
		cp	0FFh
		jr	z, waitcontrolkey

funcloop:				; CODE XREF: WaitEnterFunction+1Bj
					; WaitEnterFunction+24j
		ld	a, (hl)
		cp	0FFh
		jr	z, nofunction
		cp	0FEh
		jr	z, FlashRegI	; I
		cp	b
		jr	z, SetHLFuncAddr
		inc	hl
		inc	hl
		inc	hl
		jr	funcloop
; ---------------------------------------------------------------------------

nofunction:				; CODE XREF: WaitEnterFunction+Fj
		ld	a, (BreakCounter)
		or	a
		jr	z, FlashRegI	; I
		inc	hl
		jr	funcloop
; ---------------------------------------------------------------------------

FlashRegI:				; CODE XREF: WaitEnterFunction+13j
					; WaitEnterFunction+21j
		ld	a, seg7B|seg7C	; I
		push	de
		call	FlashDisplay
		pop	hl
		jr	WaitFunction
; ---------------------------------------------------------------------------

SetHLFuncAddr:				; CODE XREF: WaitEnterFunction+16j
		inc	hl
		ld	a, (hl)
		inc	hl
		ld	h, (hl)
		ld	l, a
		pop	bc
		pop	de
		ret
; End of function WaitEnterFunction


; =============== S U B	R O U T	I N E =======================================

; Save Display to backup
;
;

SafeDisply:				; CODE XREF: FlashDisplay+3p
		ld	hl, OUTBU
		ld	de, SysDisplayBackup

saferestor:				; CODE XREF: RestoreDisplay+6j
		ld	bc, 8
		ldir
		ret
; End of function SafeDisply


; =============== S U B	R O U T	I N E =======================================

; Restore Display from backup

RestoreDisplay:				; CODE XREF: FlashDisplay+Fp
		ld	hl, SysDisplayBackup
		ld	de, OUTBU
		jr	saferestor
; End of function RestoreDisplay


; =============== S U B	R O U T	I N E =======================================


FlashDisplay:				; CODE XREF: WaitEnterFunction+29p
					; Func_MM+7Bp ...
		push	hl
		push	de
		push	bc
		call	SafeDisply	; Save Display to backup
					;
					;
		ld	hl, FlashReg	; ""
		call	CopyHLAtoDisplay ; Copies 8 byte from (HL) or A	to Display 7..0
					;
		call	DELAY_1		; Verzgerung 1.28sec
					; Der Einsprung
					; zum Unterprogramm DELAY 1 ergibt die damit maxlmal erreichbare
					; Verzögerung von 256 * 5 = 1.280 ms =	1,28 s.	Dies Unterprogramm
					; zerstört keine Registerinhalte, erwartet aber im B Register den
					; Verzögerungswert.
		call	RestoreDisplay	; Restore Display from backup
		call	_OUTCH		; Refresh Display Buffer to Device
		pop	bc
		pop	de
		pop	hl
		ret
; End of function FlashDisplay

; ---------------------------------------------------------------------------
FuncDispatcher:	db KeyCode_MM		; DATA XREF: MainLoop:WaitDoFunctiono
		dw Func_MM
		db KeyCode_TR
		dw Func_TR
		db KeyCode_RG
		dw Func_RG
		db KeyCode_SS
		dw Func_SS
		db KeyCode_BP
		dw Func_BP
		db KeyCode_EX
		dw Extend4_8
		db KeyCode_TW
		dw Func_TW		; Programm Number
		db KeyCode_RN
		dw Func_RN
		db 0FFh
		db 14h
		db  30h	; 0
		db    5
		db  1Eh
		db  6Bh	; k
		db    1
		db 0FEh
TABD:		db 0, 0Fh		; DATA XREF: _GETH+1o
					; MapAonHexKeyMap+1o
					; HEX Code Tabelle
		db 1, 0Eh		; Key E
		db 2, 0Dh		; Key D
		db 3, 0Ch		; Key C
		db 8, 0Bh		; Key B
		db 9, 0Ah		; Key A
		db 0Ah,	9		; Key 9
		db 0Bh,	8		; Key 8
		db 10h,	7		; Key 7
		db 11h,	6		; Key 6
		db 12h,	5		; Key 5
		db 13h,	4		; Key 4
		db 18h,	3		; Key 3
		db 19h,	2		; Key 2
		db 1Ah,	1		; Key 1
		db 1Bh,	0		; Key 0
		db 1Dh,	1Dh		; Key SA
		db 0FFh
keyctrlmap:	db 4, 4			; DATA XREF: GetCtrlKey+1o
					; Key MM
		db 5, 5			; Key RN
		db 6, 6			; Key SS
		db 0Ch,	0Ch		; Key TR
		db 0Dh,	0Dh		; Key TW
		db 0Eh,	0Eh		; Key BP
		db 0Fh,	0Fh		; Key EX
		db 14h,	14h		; Key +
		db 15h,	15h		; Key -
		db 16h,	16h		; Key IN
		db 17h,	17h		; Key RL
		db 1Ch,	1Ch		; Key SO
		db 1Dh,	1Dh		; Key SA
		db 1Eh,	1Eh		; Key EN
		db 1Fh,	1Fh		; Key RG
		db 0FFh
TAB7:		db seg7E|seg7F|seg7A|seg7B|seg7C|seg7D ; DATA XREF: _CONV7SEG+5o
					; 0
		db seg7B|seg7C		; 1
		db seg7E|seg7G|seg7A|seg7B|seg7D ; 2
		db seg7G|seg7A|seg7B|seg7C|seg7D ; 3
		db seg7F|seg7G|seg7B|seg7C ; 4
		db seg7F|seg7G|seg7A|seg7C|seg7D ; 5
		db seg7E|seg7F|seg7G|seg7A|seg7C|seg7D ; 6
		db seg7A|seg7B|seg7C	; 7
		db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C|seg7D ; 8
		db seg7F|seg7G|seg7A|seg7B|seg7C ; 9
		db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; A
		db seg7E|seg7F|seg7G|seg7C|seg7D ; B
		db seg7E|seg7F|seg7A|seg7D ; C
		db seg7E|seg7G|seg7B|seg7C|seg7D ; D
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
		db seg7E|seg7F|seg7G|seg7A ; F
PrmRegs:	db    0			; DATA XREF: Func_RG+2Co
		db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; A
		db seg7E|seg7F|seg7G|seg7A ; F
		dw UserRegAF
		db    1
		db seg7E|seg7F|seg7G|seg7C|seg7D ; B
		db seg7E|seg7F|seg7A|seg7D ; C
		dw UserRegBC
		db    2
		db seg7E|seg7G|seg7B|seg7C|seg7D ; D
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
		dw UserRegDE
		db    3
		db seg7E|seg7F|seg7G|seg7B|seg7C ; H
		db seg7E|seg7F|seg7D	; L
		dw UserRegHL
		db    4
		db seg7E|seg7F|seg7G|seg7P|seg7A|seg7B|seg7C ; A
		db seg7E|seg7F|seg7G|seg7A ; F
		dw UserRegAF_
		db    5
		db seg7E|seg7F|seg7G|seg7P|seg7C|seg7D ; B
		db seg7E|seg7F|seg7A|seg7D ; C
		dw UserRegBC_
		db    6
		db seg7E|seg7G|seg7P|seg7B|seg7C|seg7D ; D
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
		dw UserRegDE_
		db    7
		db seg7E|seg7F|seg7G|seg7P|seg7B|seg7C ; H
		db seg7E|seg7F|seg7D	; L
		dw UserRegHL_
		db    8
		db seg7B|seg7C		; I
		db seg7E|seg7F|seg7G|seg7B|seg7C ; X
		dw UserRegIX
		db    9
		db seg7B|seg7C		; I
		db seg7E|seg7F|seg7G|seg7B ; Y
		dw UserRegIY
		db  0Ah
		db seg7E|seg7F|seg7G|seg7A|seg7B ; P
		db seg7E|seg7F|seg7A|seg7D ; C
		dw UserProgramPtr
		db  0Bh
		db seg7F|seg7G|seg7A|seg7C|seg7D ; S
		db seg7E|seg7F|seg7G|seg7A|seg7B ; P
		dw UsetStackPtr
		db  0Ch
		db 0
		db seg7B|seg7C		; I
		dw RegIR
		db seg7G		; -
		db seg7E|seg7F|seg7A|seg7B|seg7C|seg7D ; 0
		db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C|seg7D ; 8
		db seg7G
		db seg7G
		db seg7E|seg7F|seg7G|seg7A|seg7B ; P
		db seg7E|seg7C|seg7D	; u
intro:		db seg7G		; DATA XREF: MainLoopo
					; -
		db    0
		db 0F3h
		db    0
		db    0
		db    5
		db    5
		db 97h
FlashReg:	.ascii 0,0,0,0,0,0	; DATA XREF: FlashDisplay+6o
					; Func_MM+D7o ...
		db seg7E|seg7F|seg7G|seg7A|seg7C|seg7D ; G
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
dpl_reg:	db seg7E|seg7G		; DATA XREF: Func_RGo
					; r
		db 0
		db seg7E|seg7G|seg7C	; n
		db seg7E|seg7C|seg7D	; u
dpl_run:	db seg7E|seg7G		; DATA XREF: Func_RNo Func_RN+19o
					; r
		db 0
		db seg7E|seg7G		; r
		db seg7E|seg7G|seg7B|seg7C|seg7D ; d
dpl_Adr:	db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; DATA XREF: Func_MMo
					; Func_SS+5o
					; A d r
		db seg7E|seg7G|seg7B|seg7C|seg7D ; d
		db    0
		db seg7E|seg7G|seg7B|seg7C|seg7D ; d
dpl_Ad_d:	db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; DATA XREF: ExtendE+7o
					; A
		db 0
		db 0
		db seg7E|seg7F|seg7G|seg7A|seg7B ; p
dpl_bp:		db seg7E|seg7F|seg7G|seg7C|seg7D ; DATA	XREF: Func_BP+3o
					; b
		db seg7G		; -
		db seg7E|seg7F|seg7G|seg7A|seg7B ; p
		db seg7E|seg7F|seg7G|seg7C|seg7D ; b
dpl_bp_:	db seg7G		; DATA XREF: NMI+3Do
					; -
		db seg7F|seg7G|seg7A|seg7C|seg7D ; S
		db seg7E|seg7G		; r
		db seg7E|seg7G|seg7B|seg7C|seg7D ; d
dpl_Adrs:	db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; DATA XREF: Func_MM+8Co
					; Func_TW+7o ...
					; A
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
		db seg7E|seg7G		; r
		db seg7E|seg7G|seg7B|seg7C|seg7D ; d
dpl_Adre:	db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; DATA XREF: Func_MM+C5o
					; Func_TW+10o ...
					; A
		db seg7E|seg7G|seg7C	; n
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
		db seg7E|seg7F|seg7D	; L
dpl_plen:	db seg7E|seg7F|seg7G|seg7A|seg7B ; DATA	XREF: Func_TW+2Do
					; p
		db seg7E|seg7G		; r
		db seg7E|seg7G|seg7C	; n
		db seg7E|seg7G		; r
dpl_prnr:	db seg7E|seg7F|seg7G|seg7A|seg7B ; DATA	XREF: Func_TWo
					; P
		db seg7E|seg7G|seg7B|seg7C|seg7D ; d
		db seg7E|seg7F|seg7G|seg7A|seg7B|seg7C ; A
		db seg7E|seg7F|seg7G|seg7A|seg7D ; E
dpl_read:	db seg7E|seg7G		; DATA XREF: Func_TRo
					; r
		db 0
		db seg7E|seg7G|seg7C	; n
		db seg7C
Epr:		.ascii 0,0,0,0,0	; DATA XREF: Func_TR+Ao
		db seg7G		; -
		db seg7E|seg7G		; r
		db seg7E|seg7F|seg7G|seg7A|seg7B ; p
dpl_Epr_:	db seg7E|seg7F|seg7G|seg7A|seg7D ; DATA	XREF: Extend4_8o
					; E

; =============== S U B	R O U T	I N E =======================================


Func_MM:				; DATA XREF: ROM:032Co
		ld	hl, dpl_Adr	; A d r
		call	SENDPR_1	; HL-Anzeige (links)
					; Durch	Aufruf des Unterprogramms SENDPR 1 wird, wie SENDPTR aber
					; ohne Laden des C-Registers, zu den 4 linken Anzeigen ausgegeben.
		call	EditAddress	; returns Address on HL
		xor	a
		ld	(DataBuffer), a

DisplayMM:				; CODE XREF: Func_MM+4Aj Func_MM+88j ...
		ld	a, (hl)		; Get Byte
		call	DisplayByteDataMsb
		call	SENDHL_1	; HL-Anzeigen (links)

PredMM:					; CODE XREF: Func_MM+44j Func_MM+6Cj
		ld	hl, (AddrBuffer)
		call	GetCtrlKey	; Wait for Key.	Return A=FF if not an Control-Key
		cp	0FFh
		jr	z, ChkEditMM
		ld	a, (BreakCounter)
		or	a
		ld	a, b
		jr	z, nostep
		cp	6
		jp	z, SingleStep

nostep:					; CODE XREF: Func_MM+23j
		cp	KeyCode_EN
		jp	z, MainLoop
		cp	KeyCode_RL
		jr	z, MM_RL
		cp	KeyCode_IN
		jp	z, MM_IN
		cp	KeyCode_SD
		jr	z, SaveMM
		inc	hl
		cp	KeyCode_PLUS
		jr	z, NextMM
		dec	hl
		cp	KeyCode_MINUS
		jr	nz, PredMM
		dec	hl

NextMM:					; CODE XREF: Func_MM+3Fj
		ld	(AddrBuffer), hl
		jr	DisplayMM
; ---------------------------------------------------------------------------

ChkEditMM:				; CODE XREF: Func_MM+1Cj
		ld	a, b
		call	MapAonHexKeyMap	; Returns FF if	rA is not a HexKeyCode
		ld	b, a
		ld	a, (DataBuffer)
		rlca
		rlca
		rlca
		rlca
		and	0F0h
		or	b
		ld	(DataBuffer), a
		ld	a, b
		call	_CONV7SEG
		ld	hl, OUTBU
		ld	b, (hl)
		ld	(hl), a
		inc	hl
		ld	(hl), b
		call	_OUTCH		; Refresh Display Buffer to Device
		jr	PredMM
; ---------------------------------------------------------------------------

SaveMM:					; CODE XREF: Func_MM+3Aj Func_MM+E8j
		ld	a, (DataBuffer)
		ld	(hl), a
		cp	(hl)
		jr	nz, NextMMAddr	; No RAM
		inc	hl

NextMMAddr:				; CODE XREF: Func_MM+73j
		ld	(AddrBuffer), hl
		ld	a, seg7E|seg7G|seg7A|seg7B|seg7D ; S
		call	nz, FlashDisplay

NewMM:					; CODE XREF: Func_MM+F2j
		xor	a
		ld	(DataBuffer), a
		ld	bc, 400h
		call	FillDispl	; fill Display b bytes with c
		jp	DisplayMM
; ---------------------------------------------------------------------------
; Relativ distance

MM_RL:					; CODE XREF: Func_MM+31j
		push	hl
		ld	hl, dpl_Adrs	; A
		call	GetAddr
		pop	de		; Curr Addr
		push	de
		inc	de
		or	a
		sbc	hl, de		; New -	Cur Addr
		ld	a, h
		jr	c, RelDown
		cp	0
		jr	nz, RelUp
		ld	a, l
		cp	80h
		jr	nc, RelUp

StoreMM:				; CODE XREF: Func_MM+B6j
		pop	hl
		ld	(hl), a
		inc	hl
		ld	(AddrBuffer), hl
		jp	DisplayMM
; ---------------------------------------------------------------------------

RelDown:				; CODE XREF: Func_MM+99j
		cp	0FFh
		jr	nz, RelUp
		ld	a, l
		cp	80h
		jr	c, RelUp
		jr	StoreMM
; ---------------------------------------------------------------------------

RelUp:					; CODE XREF: Func_MM+9Dj Func_MM+A2j ...
		ld	a, seg7G|seg7A|seg7B|seg7C|seg7D ; 3
		call	FlashDisplay
		pop	hl
		ld	(AddrBuffer), hl
		jp	DisplayMM
; ---------------------------------------------------------------------------

MM_IN:					; CODE XREF: Func_MM+35j
		push	hl
		ld	hl, dpl_Adre	; A
		call	GetAddr
		ex	de, hl
		pop	hl
		ld	(AddrBuffer), hl
		ex	de, hl
		push	hl
		or	a
		sbc	hl, de
		ld	c, l
		ld	b, h
		ld	hl, FlashReg	; ""
		ld	a, seg7F|seg7G|seg7B|seg7C ; µ
		jr	c, FlashMM
		inc	bc
		pop	hl
		ld	e, l
		ld	d, h
		inc	de
		lddr
		ld	hl, (AddrBuffer)
		jp	SaveMM
; ---------------------------------------------------------------------------

FlashMM:				; CODE XREF: Func_MM+DCj
		call	FlashDisplay
		pop	de
		ld	hl, (AddrBuffer)
		jp	NewMM
; End of function Func_MM


; =============== S U B	R O U T	I N E =======================================


Func_SS:				; DATA XREF: ROM:0335o
		ld	a, 1
		ld	(BreakCounter),	a
		ld	hl, dpl_Adr	; A d r
		call	GetAddr
		ld	(UserProgramPtr), hl
		call	WaitEnter

SingleStep:				; CODE XREF: Func_MM+27j Func_RG+87j
		ld	hl, (UserProgramPtr)
		ld	(BreakPointAddr), hl
		ld	de, BreakPointOrig
		ld	a, (hl)
		ld	(de), a
		inc	de
		ld	a, 0D7h		; RST 10
		ld	(de), a
		ld	(hl), a
		jr	GoUserProc
; End of function Func_SS


; =============== S U B	R O U T	I N E =======================================


Func_RN:				; DATA XREF: ROM:0341o
		ld	hl, dpl_run	; r
		call	SENDPR_1	; HL-Anzeige (links)
					; Durch	Aufruf des Unterprogramms SENDPR 1 wird, wie SENDPTR aber
					; ohne Laden des C-Registers, zu den 4 linken Anzeigen ausgegeben.
		xor	a
		ld	(BreakCounter),	a
		ld	hl, (UserProgramPtr)
		ld	(AddrBuffer), hl
		call	EditAddress	; returns Address on HL
		ld	(UserProgramPtr), hl
		call	WaitEnter
		ld	hl, dpl_run	; r
		call	SetHLtoDispData	; SetHLtoDisp Data
; End of function Func_RN


; =============== S U B	R O U T	I N E =======================================


GoUserProc:				; CODE XREF: Func_SS+21j
		ld	sp, UserRegAF
		pop	af		; Working set
		pop	bc
		pop	de
		pop	hl
		ex	af, af'
		pop	af
		ex	af, af'
		exx
		pop	bc		; secound set
		pop	de
		pop	hl
		exx
		pop	ix
		pop	iy
		ld	sp, (UsetStackPtr)
		push	hl
		ld	hl, (UserProgramPtr)
		ld	(TempByte), a
		ld	a, (RegIR)
		ld	i, a
		ld	a, (TempByte)
		ex	(sp), hl
		ret
; End of function GoUserProc


; =============== S U B	R O U T	I N E =======================================


Func_RG:				; CODE XREF: Func_RG+7Bj
					; DATA XREF: ROM:0332o
		ld	hl, dpl_reg	; r
		call	SENDDS_1	; 8-Digit-Anzeige (kom)

GetRegKey:				; CODE XREF: Func_RG+Bj Func_RG+17j ...
		call	GetHexKey	; AF BC	DE HL AF'BC'DE'HL'IX IY PC SP IS FL FL'
		cp	0Fh
		jr	z, GetRegKey	; Skip 0xF no Register function
		cp	0FFh
		jr	nz, RegKey
		ld	a, b
		cp	KeyCode_EN
		jp	z, MainLoop
		jr	GetRegKey
; ---------------------------------------------------------------------------

RegKey:					; CODE XREF: Func_RG+Fj
		ld	hl, UserRegAF
		cp	0Dh		; FL
		jp	z, DisplBinary
		ld	hl, UserRegAF_
		cp	0Eh		; FL'
		jp	z, DisplBinary

GetRegIdx:				; CODE XREF: Func_RG+34j Func_RG+90j ...
		ld	(TempByte), a
		ld	hl, PrmRegs
		cp	0Dh
		jr	c, SearchReg
		xor	a
		jr	GetRegIdx
; ---------------------------------------------------------------------------

SearchReg:				; CODE XREF: Func_RG+31j Func_RG+3Fj
		ld	b, (hl)
		cp	b
		jr	z, RegFound
		inc	hl
		inc	hl
		inc	hl
		inc	hl
		inc	hl
		jr	SearchReg
; ---------------------------------------------------------------------------

RegFound:				; CODE XREF: Func_RG+38j
		inc	hl
		ld	e, (hl)
		inc	hl
		ld	d, (hl)		; DE = Prompt Register Name
		inc	hl
		ld	b, (hl)
		inc	hl
		ld	h, (hl)
		ld	l, b		; HL Register Storage Address
		push	hl
		ld	hl,  OUTBU+7
		xor	a
		ld	(hl), a
		dec	hl
		ld	(hl), e
		dec	hl
		ld	(hl), d
		dec	hl
		ld	(hl), a		; Prompt set
		call	_OUTCH		; Refresh Display Buffer to Device
		pop	hl		; Reg Storage Addr
		ld	e, (hl)
		inc	hl
		ld	d, (hl)
		dec	hl
		ex	de, hl
		call	DisplayHLData	; Display byte HL on the right Segemnts

RegLoop:				; CODE XREF: Func_RG+82j Func_RG+8Aj
		call	GetHexKey
		cp	0FFh
		jr	z, NoHex
		jr	EditRegister
; ---------------------------------------------------------------------------

NoHex:					; CODE XREF: Func_RG+67j
		ld	a, b
		cp	KeyCode_PLUS
		jr	z, SelectRegister
		cp	KeyCode_MINUS
		jr	z, PreReg
		cp	KeyCode_EN
		jp	z, MainLoop
		cp	KeyCode_RG
		jp	z, Func_RG
		ld	a, (BreakCounter)
		or	a
		jr	z, RegLoop
		ld	a, KeyCode_SS
		cp	b
		jp	z, SingleStep
		jr	RegLoop
; ---------------------------------------------------------------------------

SelectRegister:				; CODE XREF: Func_RG+6Ej Func_RG+D3j
		ld	a, (TempByte)
		inc	a
		jr	GetRegIdx
; ---------------------------------------------------------------------------

PreReg:					; CODE XREF: Func_RG+72j
		ld	a, (TempByte)
		dec	a
		jr	GetRegIdx
; ---------------------------------------------------------------------------

EditRegister:				; CODE XREF: Func_RG+69j
		push	de
		push	af
		ld	bc, 4F3h	; 4 x 0
		call	FillDispl	; Clear	Data XXXX 0000
		pop	af
		pop	de
		ld	hl, 0
		ld	(TempWord), hl

nextdigit:				; CODE XREF: Func_RG+C5j
		ld	b, a
		ld	hl, (TempWord)
		add	hl, hl
		add	hl, hl
		add	hl, hl
		add	hl, hl
		add	a, l
		ld	l, a
		ld	(TempWord), hl
		ld	a, b
		call	_CONV7SEG
		push	de
		call	InsertData	; shift	display-data left and insert a
		pop	de

NextRegHex:				; CODE XREF: Func_RG+CAj
		call	GetHexKey
		cp	0FFh
		jr	z, CheckEndEdit
		jr	nextdigit
; ---------------------------------------------------------------------------

CheckEndEdit:				; CODE XREF: Func_RG+C3j
		ld	a, b
		cp	KeyCode_SD
		jr	nz, NextRegHex
		ld	hl, (TempWord)
		ex	de, hl
		ld	(hl), e
		inc	hl
		ld	(hl), d
		jr	SelectRegister
; ---------------------------------------------------------------------------

DisplBinary:				; CODE XREF: Func_RG+1Ej Func_RG+26j
		ld	a, (hl)
		ld	hl, OUTBU
		ld	b, 8

NextBit:				; CODE XREF: Func_RG+E4j
		ld	c, seg7B|seg7C	; 1
		rrca
		jr	c, Bit2Display
		ld	c, seg7E|seg7F|seg7A|seg7B|seg7C|seg7D ; 0

Bit2Display:				; CODE XREF: Func_RG+DEj
		ld	(hl), c
		inc	hl
		djnz	NextBit
		call	_OUTCH		; Refresh Display Buffer to Device
		jp	GetRegKey
; End of function Func_RG


; =============== S U B	R O U T	I N E =======================================


GetHexKey:				; CODE XREF: Func_RG:GetRegKeyp
					; Func_RG:RegLoopp ...
		call	_GETH		; Wait for Key.	Return A=FF if not an Hex-Key
		cp	KeyCode_SA
		jr	z, GetHexKey
		ret
; End of function GetHexKey


; =============== S U B	R O U T	I N E =======================================


EnterDataByte:				; CODE XREF: GETHXj ExtendF+6p
		push	hl
		push	bc
		xor	a
		ld	(DataBuffer), a
		ld	bc, 400h
		call	FillDispl	; #### ----
		call	_OUTCH		; Refresh Display Buffer to Device

EditDataLoop:				; CODE XREF: EnterDataByte+32j
					; EnterDataByte+37j
		call	GetHexKey
		cp	0FFh
		jr	z, NoHexKeyEntered
		ld	b, a
		ld	a, (DataBuffer)
		rlca
		rlca
		rlca
		rlca
		and	0F0h
		or	b
		ld	(DataBuffer), a
		ld	a, b
		call	_CONV7SEG
		ld	hl, OUTBU
		ld	b, (hl)
		ld	(hl), a
		inc	hl
		ld	(hl), b
		call	_OUTCH		; Refresh Display Buffer to Device
		jr	EditDataLoop
; ---------------------------------------------------------------------------

NoHexKeyEntered:			; CODE XREF: EnterDataByte+14j
		ld	a, b
		cp	KeyCode_SD
		jr	nz, EditDataLoop
		ld	bc, 200h
		call	FillDispl	; #### ##--
		call	_OUTCH		; Refresh Display Buffer to Device
		ld	a, (DataBuffer)
		ld	b, a
		call	DisplayByteDataMsb ; #### XX--
		ld	a, b
		pop	bc
		pop	hl
		ret
; End of function EnterDataByte


; =============== S U B	R O U T	I N E =======================================

; Programm Number

Func_TW:				; DATA XREF: ROM:033Eo
		ld	hl, dpl_prnr	; P
		call	ClrGetAddr
		push	hl
		ld	hl, dpl_Adrs	; Start	Address
		call	ClrGetAddr
		ld	(TempWord), hl
		ld	hl, dpl_Adre	; End Address
		call	ClrGetAddr
		push	hl
		call	DisplayHLData	; Display end-addr on data ####	XXXX
		ld	hl, (TempWord)
		call	SENDHL_1	; Display start-addr on	addr XXXX ####
		ex	de, hl		; DE = Start
		pop	hl		; HL = End
		or	a
		sbc	hl, de		; HL = size = end - start
		pop	de		; DE = FileNumber
		jr	c, RangeError	; Len must be positiv
		inc	hl		; plus 1 for checksum
		push	hl
		call	WaitEnter	; Wait for Key
		ld	hl, dpl_plen	; p
		call	SENDDS_1	; 8-Digit-Anzeige (kom)
		pop	hl
		push	hl
		call	DisplayHLData	; Display byte HL on the right Segemnts
		pop	bc
		ld	hl, (TempWord)
		call	WriteTape	; HL start, BC Size
		jp	MainLoop
; End of function Func_TW

; ---------------------------------------------------------------------------
; START	OF FUNCTION CHUNK FOR ExtendE

RangeError:				; CODE XREF: Func_TW+26j ExtendE+3j ...
		ld	a, seg7F|seg7G|seg7A|seg7C|seg7D ; 5

FlashMain:
		call	FlashDisplay
		jp	MainLoop
; END OF FUNCTION CHUNK	FOR ExtendE

; =============== S U B	R O U T	I N E =======================================


Func_TR:				; DATA XREF: ROM:032Fo
		ld	hl, dpl_read	; r
		call	ClrGetAddr
		push	hl		; File number
		call	WaitEnter
		ld	hl, Epr		; ""
		call	SetHLtoDispData	; SetHLtoDisp Data
		pop	hl
		call	TapeReadFile	; HL File number
		jr	c, loc_736
		ld	(UserProgramPtr), hl

loc_72D:				; CODE XREF: Func_TR+2Aj
		call	DisplayHLData	; Display byte HL on the right Segemnts
		call	WaitEnter
		jp	MainLoop
; ---------------------------------------------------------------------------

loc_736:				; CODE XREF: Func_TR+14j
		push	hl
		ld	hl, FlashReg	; ""
		call	SENDPR_1	; HL-Anzeige (links)
					; Durch	Aufruf des Unterprogramms SENDPR 1 wird, wie SENDPTR aber
					; ohne Laden des C-Registers, zu den 4 linken Anzeigen ausgegeben.
		pop	hl
		jr	loc_72D
; End of function Func_TR


; =============== S U B	R O U T	I N E =======================================

; HL start, BC Size

WriteTape:				; CODE XREF: Func_TW+3Cp
		push	bc
		ld	a, 88h		; Port Cupper input all	other output
		out	(PIO_8255_CntrlStatus),	a
		di
		ld	bc, 12288

Pulse12288:				; CODE XREF: WriteTape+Fj
		call	PulsWriteHIGH
		dec	bc
		ld	a, b
		or	c
		jr	nz, Pulse12288
		call	PulsWriteLOW
		ld	b, 16

Pulse16:				; CODE XREF: WriteTape+19j
		call	PulsWriteHIGH
		djnz	Pulse16
		ld	a, d
		call	TapeWriteByte
		ld	a, e
		call	TapeWriteByte	; DE = File Number
		ld	a, h
		call	TapeWriteByte
		ld	a, l
		call	TapeWriteByte	; HL = Start Addr
		ld	a, h
		add	a, l
		call	TapeWriteByte	; H + L
		pop	bc
		ld	a, b
		call	TapeWriteByte
		ld	a, c
		call	TapeWriteByte	; BC = File Size
		ld	a, b
		add	a, c
		call	TapeWriteByte	; B + C
		push	bc
		ld	b, 64

Pulse64H:				; CODE XREF: WriteTape+44j
		call	PulsWriteHIGH
		djnz	Pulse64H
		pop	bc
		xor	a

TapeWriteData:				; CODE XREF: WriteTape+55j
		add	a, (hl)
		push	af
		ld	a, (hl)
		call	TapeWriteByte
		inc	hl
		dec	bc
		ld	a, b
		or	c
		jr	z, EndWriteData
		pop	af
		jr	TapeWriteData
; ---------------------------------------------------------------------------

EndWriteData:				; CODE XREF: WriteTape+52j
		pop	af
		call	TapeWriteByte	; Checksum
		ei
		ret
; End of function WriteTape


; =============== S U B	R O U T	I N E =======================================


TapeWriteByte:				; CODE XREF: WriteTape+1Cp
					; WriteTape+20p ...
		push	bc
		call	PulsWriteLOW	; StartByte
		ld	b, 8		; bits

BitLoop:				; CODE XREF: TapeWriteByte+Dj
		rra
		call	c, PulsWriteHIGH
		call	nc, PulsWriteLOW
		djnz	BitLoop
		ld	b, 3

Stop3HIGH:				; CODE XREF: TapeWriteByte+14j
		call	PulsWriteHIGH
		djnz	Stop3HIGH
		pop	bc
		ret
; End of function TapeWriteByte


; =============== S U B	R O U T	I N E =======================================


PulsWriteHIGH:				; CODE XREF: WriteTape:Pulse12288p
					; WriteTape:Pulse16p ...
		push	bc
		ld	b, 29h

PulseHbLb:				; CODE XREF: PulsWriteLOW+3j
		push	af
