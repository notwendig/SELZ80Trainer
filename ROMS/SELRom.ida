; End of function PrintReg_b


; =============== S U B	R O U T	I N E =======================================


PioRegOut:				; CODE XREF: PrintReg_b+1p

; FUNCTION CHUNK AT 0E3B SIZE 00000003 BYTES

		call	PioPromptHL3
		jr	PioHLSpaceOut
; ---------------------------------------------------------------------------

PromptIHLI:				; CODE XREF: ExtendC+10p
		call	PioPromptHL3
		call	HL_IHLI		; HL = (HL)
		jr	PioHLSpaceOut
; ---------------------------------------------------------------------------

PromtBinByte:				; CODE XREF: ExtendC+34p ExtendC+45p
		call	PioPromptHL3
		ld	b, 8
		ld	a, l

loPromtBinByte:				; CODE XREF: PioRegOut+1Dj
		ld	c, '1'
		rlca
		jr	c, BitOut

NulBitOut:
		ld	c, '0'

BitOut:					; CODE XREF: PioRegOut+16j
		call	PrintC
		djnz	loPromtBinByte
		ret
; ---------------------------------------------------------------------------

PioHLSpaceOut:				; CODE XREF: ExtendD+37p PioRegOut+3j	...
		call	PioHLHexOut
		jr	Pio2Space
; End of function PioRegOut


; =============== S U B	R O U T	I N E =======================================


PioHLHexOut:				; CODE XREF: PioRegOut:PioHLSpaceOutp
		call	PrintSpace
		ld	a, h
		call	PrintHex
		ld	a, l
; End of function PioHLHexOut


; =============== S U B	R O U T	I N E =======================================


PrintHex:				; CODE XREF: ExtendD+3Ep
					; PioHLHexOut+4p
		push	af
		call	AsciMSN
		ld	c, a
		call	PrintC
		pop	af
		push	af
		call	AsciiHex
		ld	c, a
		call	PrintC
		pop	af
		ret
; End of function PrintHex


; =============== S U B	R O U T	I N E =======================================


AsciMSN:				; CODE XREF: PrintHex+1p
		rrca
		rrca
		rrca
		rrca
; End of function AsciMSN


; =============== S U B	R O U T	I N E =======================================


AsciiHex:				; CODE XREF: PrintHex+Ap
		and	0Fh
		add	a, '0'
		cp	':'
		ret	c
		add	a, 7
		ret
; End of function AsciiHex


; =============== S U B	R O U T	I N E =======================================

; HL = (HL)

HL_IHLI:				; CODE XREF: PioPromptHL3+10p
					; PioPromptHL3+13j ...
		ld	e, (hl)
		inc	hl
		ld	d, (hl)
		ex	de, hl
		ret
; End of function HL_IHLI

; ---------------------------------------------------------------------------
; START	OF FUNCTION CHUNK FOR PioRegOut

Pio2Space:				; CODE XREF: PioRegOut+23j
		call	PrintSpace
; END OF FUNCTION CHUNK	FOR PioRegOut

; =============== S U B	R O U T	I N E =======================================


PrintSpace:				; CODE XREF: ExtendC:Space16p
					; ExtendD+41p ...
		ld	c, ' '
		jr	PrintC
; End of function PrintSpace


; =============== S U B	R O U T	I N E =======================================


Pio2CRLF:				; CODE XREF: ExtendC:LFRetp
					; ExtendD+31p
		call	PrinterCRLF
; End of function Pio2CRLF


; =============== S U B	R O U T	I N E =======================================


PrinterCRLF:				; CODE XREF: ExtendC+26p ExtendC+37p ...
		ld	c, 0Ah
		call	PrintC
		ld	c, 0Dh
; End of function PrinterCRLF


; =============== S U B	R O U T	I N E =======================================


PrintC:					; CODE XREF: PRTCHTj ExtendC+21p ...
		push	af

wpio20:					; CODE XREF: PrintC+5j
		in	a, (PIO_8255_PortC)
		and	20h		; Busy
		jr	nz, wpio20
		ld	a, c
		out	(PIO_8255_PortB), a
		pop	af
		ret
; End of function PrintC


; =============== S U B	R O U T	I N E =======================================


OutcChksum:				; CODE XREF: DoRst38:OutcWRxp
					; DoRst38+97p ...
		push	af

WTxRDY:					; CODE XREF: OutcChksum+5j
		in	a, (SIO8251_CntrPort)
		bit	0, a		; TxRDY
		jr	z, WTxRDY
		ld	a, c
		out	(SIO8251_Dataport), a

WRxRDY:					; CODE XREF: OutcChksum+Ej
		in	a, (SIO8251_CntrPort)
		bit	TxEMPTY, a	; Tranmitter empty
		jr	z, WRxRDY
		pop	af
		add	a, c
		ret
; End of function OutcChksum


; =============== S U B	R O U T	I N E =======================================


SioInCChkSum:				; CODE XREF: DoRst38+2Dp
					; DoRst38:Checkp ...
		push	af
		call	WaitRxRDY	; cy if	RxReady
		jr	nc, NoByte
		in	a, (SIO8251_Dataport)
		ld	c, a
		pop	af
		add	a, c
		ret
; ---------------------------------------------------------------------------

NoByte:					; CODE XREF: SioInCChkSum+4j
		pop	af
		ex	(sp), hl
		ld	hl, SendBreak
		ex	(sp), hl
		ret
; End of function SioInCChkSum


; =============== S U B	R O U T	I N E =======================================

; cy if	RxReady

WaitRxRDY:				; CODE XREF: SioInCChkSum+1p
		push	bc
		ld	bc, 4000

WaitRX:					; CODE XREF: WaitRxRDY+Dj
		in	a, (SIO8251_CntrPort)
		rrca
		rrca
		jr	c, RetRXWait	; RxRDY
		dec	bc
		ld	a, b
		or	c
		jr	nz, WaitRX

RetRXWait:				; CODE XREF: WaitRxRDY+8j
		pop	bc
		ret
; End of function WaitRxRDY


; =============== S U B	R O U T	I N E =======================================


TxDisable:				; CODE XREF: DoRst38+28p
		push	af
		res	DTR, e		; Data Terminal	Ready

SIOCtrl:				; CODE XREF: TxRxDisable+3j
					; TxEnable+3j ...
		ld	a, e
		out	(SIO8251_CntrPort), a
		pop	af
		ret
; End of function TxDisable


; =============== S U B	R O U T	I N E =======================================


TxRxDisable:				; CODE XREF: DoRst38+47p
		push	af
		res	RTS, e		; Request to send
		jr	SIOCtrl
; End of function TxRxDisable


; =============== S U B	R O U T	I N E =======================================


TxEnable:				; CODE XREF: DoRst38:retTxENp
		push	af
		set	DTR, e		; Data Terminal	Ready
		jr	SIOCtrl
; End of function TxEnable


; =============== S U B	R O U T	I N E =======================================


TxRxEnable:				; CODE XREF: DoRst38:TxRxENOutcWRxp
					; DoRst38+93p
		push	af
		set	RTS, e		; Request to send
		jr	SIOCtrl
; End of function TxRxEnable


; =============== S U B	R O U T	I N E =======================================


DoRst38:				; CODE XREF: INTRPTj
		push	af
		in	a, (SIO8251_CntrPort)
		bit	RxRDY, a	; Check	SIO TxInt
		jr	z, UserInt
		push	bc
		in	a, (SIO8251_Dataport)
		ld	c, a
		ld	(sioCmd), a
		ld	a, (sioCmdState)
		cp	0
		jr	z, NMIRet
		cp	10h
		jr	nc, NMIRet
		ld	b, a		; 01h..10h
		cp	c
		jr	z, DoSioCmd
		xor	a
		cp	c		; cmd 0
		jr	nz, NMIRet

DoSioCmd:				; CODE XREF: DoRst38+1Bj
		push	de
		push	hl
		ld	d, b		; state
		ld	a, (SIOMode)
		ld	e, a
		call	TxDisable
		xor	a
		add	a, c		; cmd
		call	SioInCChkSum
		push	af
		ld	a, c
		cp	11h
		jr	z, ChkCecksum
		cp	55h
		jr	z, SioWriteBLK
		cp	0AAh
		jr	z, SIOReadBLK	; addr,len, data...
		pop	af

SendBreak:				; CODE XREF: DoRst38+64j DoRst38+90j
					; DATA XREF: ...
		ld	c, 0

TxRxENOutcWRx:				; CODE XREF: DoRst38+67j
		call	TxRxEnable

OutcWRx:				; CODE XREF: DoRst38+ADj
		call	OutcChksum
		call	TxRxDisable

retTxEN:				; CODE XREF: DoRst38+60j
		call	TxEnable
		pop	hl
		pop	de

NMIRet:					; CODE XREF: DoRst38+13j DoRst38+17j ...
		pop	bc
		pop	af
		ei
		ret
; ---------------------------------------------------------------------------

UserInt:				; CODE XREF: DoRst38+5j
		pop	af
		jp	UserIntProc
; ---------------------------------------------------------------------------

ChkCecksum:				; CODE XREF: DoRst38+34j
		pop	af

Check:					; CODE XREF: DoRst38+7Dj
		call	SioInCChkSum
		ld	b, a
		ld	a, (sioCmd)
		or	a
		jr	z, retTxEN
		ld	a, b
		or	a
		jr	nz, SendBreak
		ld	c, d
		jr	TxRxENOutcWRx
; ---------------------------------------------------------------------------

SIOReadBLK:				; CODE XREF: DoRst38+3Cj
		pop	af		; addr,len, data...
		call	SioInCChkSum
		ld	l, c
		call	SioInCChkSum
		ld	h, c
		call	SioInCChkSum
		ld	b, c

sioread:				; CODE XREF: DoRst38+7Bj
		call	SioInCChkSum
		ld	(hl), c
		inc	hl
		djnz	sioread
		jr	Check
; ---------------------------------------------------------------------------

SioWriteBLK:				; CODE XREF: DoRst38+38j
		pop	af
		call	SioInCChkSum
		ld	l, c
		call	SioInCChkSum
		ld	h, c
		call	SioInCChkSum
		ld	b, c
		call	SioInCChkSum
		or	a
		jr	nz, SendBreak
		ld	c, d
		call	TxRxEnable
		xor	a
		call	OutcChksum
		ld	c, 55h
		call	OutcChksum
		ld	c, b
		call	OutcChksum

siowrite:				; CODE XREF: DoRst38+A8j
		ld	c, (hl)
		call	OutcChksum
		inc	hl
		djnz	siowrite
		neg
		ld	c, a
		jr	OutcWRx
; End of function DoRst38


; =============== S U B	R O U T	I N E =======================================


_KEYSTAT:				; CODE XREF: KEYSTATj
		in	a, (IC8279_Ctrl)
		and	FIFOMSK		; Maske	für Zeichenzahl
		ret	z		; Kein Zeichen
		ld	a, 0FFh
		ret
; End of function _KEYSTAT


; =============== S U B	R O U T	I N E =======================================


BreakTxSIO:				; CODE XREF: V24INITj
		push	hl
		push	bc
		ld	hl,  SIO8251Config+3
		ld	(hl), 25h	; 25:RTS, SBrk,TxEN
		ld	hl, SIO8251Config
		ld	bc, 419h
		otir
		pop	bc
		pop	hl
		ret
; End of function BreakTxSIO


; =============== S U B	R O U T	I N E =======================================


ChkSioOutRdy:				; CODE XREF: V24STATj
		in	a, (SIO8251_CntrPort)
		bit	RxRDY, a	; Receiver Ready
		ret
; End of function ChkSioOutRdy


; =============== S U B	R O U T	I N E =======================================


SioGeta:				; CODE XREF: V24INj SioGeta+4j
		in	a, (SIO8251_CntrPort)
		bit	RxRDY, a	; Receiver Ready
		jr	z, SioGeta
		in	a, (SIO8251_Dataport)
		ret
; End of function SioGeta


; =============== S U B	R O U T	I N E =======================================


SioPuta:				; CODE XREF: V24OUTj
		push	af

waitSio:				; CODE XREF: SioPuta+5j
		in	a, (SIO8251_CntrPort)
		bit	0, a		; TxRdy
		jr	z, waitSio
		pop	af
		out	(SIO8251_Dataport), a
		ret
; End of function SioPuta


; =============== S U B	R O U T	I N E =======================================


UserDisplBufferOut:			; CODE XREF: OUTDISj
		push	hl
		push	bc
		push	af
		ld	hl, UserDisplBuffer
		ld	bc, 600h | UserDisplay_1 ; 6 segmente start port 10 Display MSD

dsplloop:				; CODE XREF: UserDisplBufferOut+12j
		ld	a, (hl)
		and	1Fh
		or	80h		; Output enabled
		out	(c), a
		inc	hl
		inc	c
		djnz	dsplloop
		outi			; BlankPort
		pop	af
		pop	bc
		pop	hl
		ret
; End of function UserDisplBufferOut


; =============== S U B	R O U T	I N E =======================================

; JP e000h if code exist

ExtendA:				; CODE XREF: Extend4_8+3Dj
		ld	hl, 0E000h

JpHLIf:					; CODE XREF: ExtendB+3j Extend9+3j
		ld	a, (hl)
		cp	0C3h		; JP nn
		jp	nz, MainLoop
		jp	(hl)
; End of function ExtendA


; =============== S U B	R O U T	I N E =======================================

; JP e003h if code exist

ExtendB:				; CODE XREF: Extend4_8+42j
		ld	hl, 0E003h
		jr	JpHLIf
; End of function ExtendB


; =============== S U B	R O U T	I N E =======================================

; JP 2808h if code exist

Extend9:				; CODE XREF: Extend4_8+38j
		ld	hl, 2808h
		jr	JpHLIf
; End of function Extend9

