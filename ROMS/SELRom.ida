; HL File number

TapeReadFile:				; CODE XREF: Func_TR+11p
		ld	a, 88h
		out	(PIO_8255_CntrlStatus),	a ; Port C[7-4]	input all other	output
		di
		ld	c, 0

RTWaitLow:				; CODE XREF: TapeReadFile+Aj
		in	a, (PIO_8255_PortC)
		rla
		jr	c, RTWaitLow

RTWaitHigh:				; CODE XREF: TapeReadFile+Fj
		in	a, (PIO_8255_PortC)
		rla
		jr	nc, RTWaitHigh

RTTimer1:				; CODE XREF: TapeReadFile+15j
		inc	c		; Count	hight time
		in	a, (PIO_8255_PortC)
		rla
		jr	c, RTTimer1	; Count	hight time
		ld	a, c
		ld	d, a		; High Timer1
		ld	b, a
		inc	b
		inc	b		; High Timer1 +	2
		ld	e, a
		srl	e		; High Timer1 /	2

SkipGap:				; CODE XREF: TapeReadFile+22j
					; TapeReadFile+2Ej
		in	a, (PIO_8255_PortC)
		rla
		jr	nc, SkipGap
		ld	c, 0

RTTimer2:				; CODE XREF: TapeReadFile+2Aj
		inc	c
		in	a, (PIO_8255_PortC)
		rla
		jr	c, RTTimer2
		ld	a, b		; Time1	+ 2
		sub	c		; Timer2-(Timer1 +2)
		jp	nc, SkipGap	; to short may be noise
		neg			; Delta	Timer2 Timer1
		cp	e		; (Time1/2) > Delta(T2,T1)
		jp	m, TapeReadError
		ld	a, d		; Timer1
		add	a, c		; + Timer2
		srl	a		; (timer1 + timer2) / 2

RTHeader:				; Set High / Low time
		ld	(IOBitTimer), a
		ld	b, 0
		call	TapeReadByte	; FileNo1
		cp	h
		ld	h, a
		jr	z, ChkFNo2	; FileNo2
		inc	b		; ErrFlag

ChkFNo2:				; CODE XREF: TapeReadFile+45j
		call	TapeReadByte	; FileNo2
		ld	c, a
		sub	l
		or	b
		ld	l, c
		jr	nz, WrongFileNumber
		call	TapeReadByte
		ld	h, a
		call	TapeReadByte
		ld	l, a		; Start
		call	TapeReadByte
		ld	d, a		; chksum start
		call	TapeReadByte
		ld	b, a
		call	TapeReadByte
		ld	c, a		; Length
		call	TapeReadByte
		ld	e, a		; chksum length
		ld	a, l
		add	a, h
		cp	d
		jr	nz, TapeReadError
		ld	a, c
		add	a, b
		cp	e
		jr	nz, TapeReadError
		push	hl
		push	bc

TapeReadData:				; CODE XREF: TapeReadFile+7Dj
		call	TapeReadByte
		ld	(hl), a
		inc	hl
		dec	bc
		ld	a, b
		or	c
		jr	nz, TapeReadData
		call	TapeReadByte
		ld	d, a
		pop	bc
		pop	hl
		push	hl
		ld	e, 0

Chksum:					; CODE XREF: TapeReadFile+8Fj
		ld	a, e
		add	a, (hl)
		ld	e, a
		inc	hl
		dec	bc
		ld	a, b
		or	c
		jr	nz, Chksum
		pop	hl
		ld	a, e
		cp	d
		ei
		ret	z

TapeReadError:				; CODE XREF: TapeReadFile+34j
					; TapeReadFile+6Cj ...
		ld	hl, 0FFFFh

WrongFileNumber:			; CODE XREF: TapeReadFile+4Fj
