		jr	z, loc_BC6
		ld	a, c
		ld	c, h
		ld	h, a

loc_BC6:				; CODE XREF: sub_BBA+7j
		ld	a, h
		cpl
		and	b
		and	c
		ld	l, a
		ld	a, c
		or	b
		cpl
		and	h
		or	l
		rlca
		rlca
		and	20h
		ld	c, a
		ld	hl, LEDlow
		ld	a, (hl)
