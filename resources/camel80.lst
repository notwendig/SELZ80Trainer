 819:			;C POSTPONE  --   postpone compile action of word
 820:			;   BL WORD FIND
 821:			;   DUP 0= ABORT" ?"
 822:			;   0< IF   -- xt  non immed: add code to current
 823:			;                  def'n to compile xt later.
 824:			;       ['] LIT ,XT  ,      add "LIT,xt,COMMAXT"
 825:			;       ['] ,XT ,XT         to current definition
 826:			;   ELSE  ,XT      immed: compile into cur. def'n
 827:			;   THEN ; IMMEDIATE
