  61:			
  62:			head    MACRO   _label,name,action
  63:					DW link
  64:					DB 0
  65:			link    DEFL $
  66:					DB _label - $ -1
  67:					DB 'name'
  68:			_label:
  69:			IF  !(action=DOCODE)
  70:					call action
  71:			ENDIF
  72:					ENDM
  73:			
  74:			immed   MACRO   _label,name,action
  75:					DW link
  76:					DB 1
  77:			link    DEFL $
  78:					DB _label - $ -1
  79:					DB 'name'
  80:			_label:
  81:					IF  !(action=DOCODE)
  82:					call action
  83:					ENDIF
  84:					ENDM
  85:			
  86:			
  87:			; NEXTHL is used when the IP is already in HL.
  88:			nexthl  MACRO
  89:					ld e,(hl)
  90:					inc hl
  91:					ld d,(hl)
  92:					inc hl
  93:					ex de,hl
  94:					jp (hl)
  95:					ENDM
  96:			
  97:			; The NEXT macro (7 bytes) assembles the 'next'
  98:			; code in-line in every Z80 CamelForth CODE word.
  99:			next    MACRO
 100:					ex de,hl
 101:					nexthl
 102:					ENDM
