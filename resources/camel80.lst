 743:			;Z (do)    n1|u1 n2|u2 --  R: -- sys1 sys2
 744:			;Z                          run-time code for DO
 745:			; '83 and ANSI standard loops terminate when the
 746:			; boundary of limit-1 and limit is crossed, in
 747:			; either direction.  This can be conveniently
 748:			; implemented by making the limit 8000h, so that
 749:			; arithmetic overflow logic can detect crossing.
 750:			; I learned this trick from Laxen & Perry F83.
 751:			; fudge factor = 8000h-limit, to be added to
 752:			; the start value.
 753:	44C6          		head xdo,(do),docode
 753:	44C6  B044    			DW link
 753:	44C8  00      			DB 0
 753:	44C9          	link    DEFL $
 753:	44C9  04      			DB xdo - $ -1
 753:	44CA  28646F29			DB '(do)'
 753:	44CE          	xdo:
 753:	0000          	IF  !(docode=DOCODE)
 753:					call docode
 753:			ENDIF
 753:	44CE          			ENDM
 754:	44CE  EB      			ex de,hl
 755:	44CF  E3      			ex (sp),hl   ; IP on stack, limit in HL
 756:	44D0  EB      			ex de,hl
 757:	44D1  210080  			ld hl,8000h
 758:	44D4  B7      			or a
 759:	44D5  ED52    			sbc hl,de    ; 8000-limit in HL
 760:	44D7  DD2B    			dec ix       ; push this fudge factor
 761:	44D9  DD7400  			ld (ix+0),h  ;    onto return stack
 762:	44DC  DD2B    			dec ix       ;    for later use by 'I'
 763:	44DE  DD7500  			ld (ix+0),l
 764:	44E1  09      			add hl,bc    ; add fudge to start value
 765:	44E2  DD2B    			dec ix       ; push adjusted start value
 766:	44E4  DD7400  			ld (ix+0),h  ;    onto return stack
 767:	44E7  DD2B    			dec ix       ;    as the loop index.
 768:	44E9  DD7500  			ld (ix+0),l
 769:	44EC  D1      			pop de       ; restore the saved IP
 770:	44ED  C1      			pop bc       ; pop new TOS
 771:	44EE          			next
 771:	44EE  EB      			ex de,hl
 771:	44EF          			nexthl
 771:	44EF  5E      			ld e,(hl)
 771:	44F0  23      			inc hl
 771:	44F1  56      			ld d,(hl)
 771:	44F2  23      			inc hl
 771:	44F3  EB      			ex de,hl
 771:	44F4  E9      			jp (hl)
 771:	44F5          			ENDM
 771:	44F5          			ENDM
