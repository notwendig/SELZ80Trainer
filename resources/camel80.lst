 786:	450C  EA1945  			jp pe,loopterm  ; overflow=loop done
 787:					; continue the loop
 788:	450F  DD7500  			ld (ix+0),l  ; save the updated index
 789:	4512  DD7401  			ld (ix+1),h
 790:	4515  D9      			exx
 791:	4516  C3A244  			jp dobranch  ; take the inline branch SIE
 792:	4519          	loopterm: ; terminate the loop
 793:	4519  010400  			ld bc,4      ; discard the loop info
 794:	451C  DD09    			add ix,bc
 795:	451E  D9      			exx
 796:	451F  13      			inc de       ; skip the inline branch
 797:	4520  13      			inc de
 798:	4521          			next
 798:	4521  EB      			ex de,hl
 798:	4522          			nexthl
 798:	4522  5E      			ld e,(hl)
