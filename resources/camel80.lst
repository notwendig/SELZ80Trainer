  15:			; - modify IO words for SEL Z80 Trainer.
  16:			; - restructured for zmac assembler.
  17:			; - add camelSEL.azm implements SEL Z80 Trainer
  18:			;   words.
  19:			;
  20:			;   Forth words are documented as follows:
  21:			;x   NAME     stack -- stack    description
  22:			;   where x=C for ANS Forth Core words, X for ANS
  23:			;   Extensions, Z for internal or private words.
  24:			;
  25:			; Direct-Threaded Forth model for Zilog Z80
  26:			; 16 bit cell, 8 bit char, 8 bit (byte) adrs unit
  27:			;    Z80 BC = Forth TOS (top Param Stack item)
  28:			;        HL =       W    working register
  29:			;        DE =       IP   Interpreter Pointer
  30:			;        SP =       PSP  Param Stack Pointer
  31:			;        IX =       RSP  Return Stack Pointer
  32:			;        IY =       UP   User area Pointer
  33:			;    A, alternate register set = temporaries
  34:			;
  35:			; Revision history:
  36:			;   19 Aug 94 v1.0
  37:			;   25 Jan 95 v1.01  now using BDOS function 0Ah
  38:			;       for interpreter input; TIB at 82h.
  39:			;   02 Mar 95 v1.02  changed ALIGN to ALIGNED in
  40:			;       S" (S"); changed ,BRANCH to ,XT in DO.
  41:			; ===============================================
  42:			; Macros to define Forth headers
  43:			; HEAD  label,length,name,action
  44:			; IMMED label,length,name,action
  45:			;    label  = assembler name for this word
  46:			;             (special characters not allowed)
  47:			;    length = length of name field
  48:			;    name   = Forth's name for this word
  49:			;    action = code routine for this word, e.g.
  50:			;             DOCOLON, or DOCODE for code words
  51:			; IMMED defines a header for an IMMEDIATE word.
  52:			;
  53:			
  54:				include SELRom.inc
