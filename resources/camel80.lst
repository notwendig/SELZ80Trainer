 773:			;Z (loop)   R: sys1 sys2 --  | sys1 sys2
 774:			;Z                        run-time code for LOOP
 775:			; Add 1 to the loop index.  If loop terminates,
 776:			; clean up the return stack and skip the branch.
 777:			; Else take the inline branch.  Note that LOOP
 778:			; terminates when index=8000h.
 779:	44F5          		head xloop,(loop),docode
 779:	44F5  C944    			DW link
 779:	44F7  00      			DB 0
 779:	44F8          	link    DEFL $
