 624:			;           IF EXECUTE ELSE ,XT THEN
 625:			;       ELSE                    -- textadr
 626:			;           ?NUMBER
 627:			;           IF POSTPONE LITERAL     converted ok
 628:			;           ELSE COUNT TYPE 3F EMIT CR ABORT  err
