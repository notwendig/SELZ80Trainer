 519:			;C                  xt  1      if immediate
 520:			;C                  xt -1      if "normal"
 521:			;   LATEST @ BEGIN             -- a nfa
 522:			;       2DUP OVER C@ CHAR+     -- a nfa a nfa n+1
 523:			;       S=                     -- a nfa f
