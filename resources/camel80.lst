 837:			;Z COMPILE   --   append inline execution token
 838:			;   R> DUP CELL+ >R @ ,XT ;
 839:			; The phrase ['] xxx ,XT appears so often that
 840:			; this word was created to combine the actions
 841:			; of LIT and ,XT.  It takes an inline literal
 842:			; execution token and appends it to the dict.
 843:			;    head COMPILE,COMPILE,docolon
 844:			;        DW RFROM,DUP,CELLPLUS,TOR
 845:			;        DW FETCH,COMMAXT,EXIT
